<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Minimal Info.plist overlay. flutter create generates the full file.
  Merge the UIBackgroundModes key into the generated Info.plist.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Cadence</string>

    <key>CFBundleDisplayName</key>
    <string>Cadence</string>

    <!-- Required for background audio playback on iOS -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>fetch</string>
    </array>

    <!-- Required for network access (ATS exception for self-hosted HTTP) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>

    <!-- Privacy strings shown on first access -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Cadence connects to your self-hosted music server.</string>
</dict>
</plist>
